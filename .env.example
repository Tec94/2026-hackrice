# Explicit local mode uses embedded PostgreSQL for credential-free development only.
# For deployment select tigerdata and provide the TigerData PostgreSQL connection URL.
DATABASE_MODE=local
DATABASE_URL=
DATABASE_ALLOW_UNVERIFIED_TLS=false
LOCAL_DATABASE_PATH=.data/postgres
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=4000
# Required for deployment, at least 32 characters; local blank creates an ephemeral secret.
BETTER_AUTH_SECRET=
# Render uses database storage; filesystem mode needs a private persistent volume.
RECORDINGS_STORAGE=filesystem
# Never expose as static files. Run one API process.
RECORDINGS_PATH=.data/recordings

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Public HTTPS endpoint to this API's /internal/think route.
DEEPGRAM_THINK_URL=
# Remains false until credentialed playback tests verify the controlled speech path.
VOICE_PLAYBACK_VALIDATED=false
BACKBOARD_API_KEY=

SOLANA_DEVNET_RPC_URL=
# Absolute local JSON keypair file, devnet only; never commit the file.
SOLANA_DEVNET_KEYPAIR_PATH=
# Local preview only. This bypasses receipt confirmation before reveal.
HACKRICE_BYPASS_RECEIPT=false
# Pins every new session to one cutoff so a demo can be rehearsed on the same
# chart. Must be an ISO timestamp on the hour. Leave blank for random cutoffs.
DEMO_CUTOFF=
