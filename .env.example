# Explicit local mode uses embedded PostgreSQL for credential-free development only.
# For deployment select tigerdata and provide the TigerData PostgreSQL connection URL.
DATABASE_MODE=local
DATABASE_URL=
LOCAL_DATABASE_PATH=.data/postgres
APP_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000
# Required for deployment, at least 32 characters; local blank creates an ephemeral secret.
BETTER_AUTH_SECRET=
# Private persistent volume, never expose as static files. Run one API process.
RECORDINGS_PATH=.data/recordings

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Public HTTPS endpoint to this API's /internal/think route.
DEEPGRAM_THINK_URL=
# Remains false until credentialed playback tests verify the controlled speech path.
VOICE_PLAYBACK_VALIDATED=false
BACKBOARD_API_KEY=

SOLANA_DEVNET_RPC_URL=
# Absolute local JSON keypair file, devnet only; never commit the file.
SOLANA_DEVNET_KEYPAIR_PATH=
